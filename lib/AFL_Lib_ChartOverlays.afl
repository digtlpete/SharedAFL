// ============================================================================
// LIB: CHART OVERLAYS — VWAP band plots, stop line, position info, alerts
// ----------------------------------------------------------------------------
// Extracted verbatim from ORB_Strategy.afl (Phase 1 library extraction).
// Rendering only — nothing here can change backtest signals.
//
// REQUIRES (host must Param() these before include — do not re-declare here;
//   a second Param() call duplicates the UI under the formula name):
//   Display params: ShowRthVwapBands, ShowRthVwap2SD, VwapColor/Style/Width,
//     SD1Color/Style/Width, SD2Color/Style/Width,
//     ShowStopLine, StopLineColor, StopLineWidth
//   Optional (typeof-guarded below — ORB and other stale hosts omit them;
//     GAG Param()s them in Chart Display, so we must not re-declare there):
//     ShowEntryLine, EntryLineColor, EntryLineWidth,
//     ShowTargetLine, TargetLineColor, TargetLineWidth,
//     ShowCurrentPriceLine, CurrentPriceLineColor, CurrentPriceLineWidth
//   Data: RthVwap, RthVwapU1SD, RthVwapL1SD, RthVwapU2SD, RthVwapL2SD
//   Signals: Buy, Sell, Short, Cover
//   Position arrays: PosDir, PosEntry, PosStop, PosTarget, PosQty
//   Misc: EnableAutoTrade (param), StrategyCode (string), _svPfx, dn
//
// PROVIDES:
//   lb (= BarCount - 1)
//   _axMin/_axMax/_px* /_axOk (for optional strategy GFX after this include)
//
// IbLogEvt() comes from AFL_Lib_IbLogEvt.afl — include_once at the
// outermost formula top, not from this file.
// ============================================================================

// ============================================================================
// DISPLAY — RTH VWAP + standard deviation bands (intraday cumulative)
// ============================================================================
rthVwapShow = ShowRthVwapBands;
rth2sdShow  = ShowRthVwapBands AND ShowRthVwap2SD;

Plot(IIf(rth2sdShow,  RthVwapL2SD, Null), "RTH -2 SD", SD2Color,  SD2Style, Null, Null, 0, 0, SD2Width);
Plot(IIf(rth2sdShow,  RthVwapU2SD, Null), "RTH +2 SD", SD2Color,  SD2Style, Null, Null, 0, 0, SD2Width);
Plot(IIf(rthVwapShow, RthVwapL1SD, Null), "RTH -1 SD", SD1Color,  SD1Style, Null, Null, 0, 0, SD1Width);
Plot(IIf(rthVwapShow, RthVwapU1SD, Null), "RTH +1 SD", SD1Color,  SD1Style, Null, Null, 0, 0, SD1Width);
Plot(IIf(rthVwapShow, RthVwap,     Null), "RTH VWAP",  VwapColor, VwapStyle, Null, Null, 0, 0, VwapWidth);

// ============================================================================
// DISPLAY — Break Markers
// ============================================================================
PlotShapes(IIf(Buy, shapeUpArrow, shapeNone), colorGreen, 0, L, -15);
PlotShapes(IIf(Short, shapeDownArrow, shapeNone), colorRed, 0, H, -15);
PlotShapes(IIf(Sell, shapeCircle, shapeNone), colorOrange, 0, H, 15);
PlotShapes(IIf(Cover, shapeCircle, shapeNone), colorOrange, 0, L, -15);

// ============================================================================
// DISPLAY — Active Entry + Stop / Trailing Stop lines (GFX horizontal)
// ============================================================================
// Stop-line Param*() stay on the host (every extracted strategy already has
// them). Entry / target / last-price: Param() only when the host never
// declared the name. typeof() is AmiBroker's Error-29-safe check; a second
// Param() on GAG would duplicate those toggles in the Parameters dialog.
if (typeof(ShowEntryLine) == "undefined")
    ShowEntryLine = ParamToggle("Show Entry Line", "No|Yes", 1);
if (typeof(EntryLineColor) == "undefined")
    EntryLineColor = ParamColor("Entry Line Color", ColorRGB(180, 180, 180));
if (typeof(EntryLineWidth) == "undefined")
    EntryLineWidth = Param("Entry Line Width", 2, 1, 5, 1);
if (typeof(ShowTargetLine) == "undefined")
    ShowTargetLine = ParamToggle("Show Take Profit Line", "No|Yes", 1);
if (typeof(TargetLineColor) == "undefined")
    TargetLineColor = ParamColor("Take Profit Line Color", colorAqua);
if (typeof(TargetLineWidth) == "undefined")
    TargetLineWidth = Param("Take Profit Line Width", 2, 1, 5, 1);
if (typeof(ShowCurrentPriceLine) == "undefined")
    ShowCurrentPriceLine = ParamToggle("Show Current Price Line", "No|Yes", 1);
if (typeof(CurrentPriceLineColor) == "undefined")
    CurrentPriceLineColor = ParamColor("Current Price Line Color", ColorRGB(205, 255, 6));
if (typeof(CurrentPriceLineWidth) == "undefined")
    CurrentPriceLineWidth = Param("Current Price Line Width", 2, 1, 5, 1);

// Prefer IB live levels when auto-trading; fall back to backtest Pos* arrays.
_curEntry  = 0;
_curStop   = 0;
_curTarget = 0;
if (EnableAutoTrade)
{
    _ibSvP = "IB_" + Name() + "_";
    _ibDir = Nz(StaticVarGet(_ibSvP + "Dir"));
    if (_ibDir != 0)
    {
        _curEntry  = Nz(StaticVarGet(_ibSvP + "FillPx"));
        _curStop   = Nz(StaticVarGet(_ibSvP + "CurStop"));
        // Working LMT TP uses CurTarget; TargetPx is the overlay seed.
        _curTarget = Nz(StaticVarGet(_ibSvP + "CurTarget"));
        if (_curTarget <= 0)
            _curTarget = Nz(StaticVarGet(_ibSvP + "TargetPx"));
    }
}
if (_curEntry == 0)
    _curEntry = Nz(PosEntry[BarCount - 1]);
if (_curStop == 0)
    _curStop = Nz(PosStop[BarCount - 1]);
if (_curTarget == 0)
    _curTarget = Nz(PosTarget[BarCount - 1]);

// GFX horizontals do not participate in Y-axis scaling. Hidden plots
// keep entry / stop / target on-scale so a 2.5R line is not drawn
// off the top of the pane. Read axis AFTER these Plots.
if (ShowEntryLine AND _curEntry > 0)
    Plot(_curEntry, "", colorDefault, styleNoDraw | styleNoLabel);
if (ShowStopLine AND _curStop > 0)
    Plot(_curStop, "", colorDefault, styleNoDraw | styleNoLabel);
if (ShowTargetLine AND _curTarget > 0)
    Plot(_curTarget, "", colorDefault, styleNoDraw | styleNoLabel);

_axMin   = Status("axisminy");
_axMax   = Status("axismaxy");
_pxTop   = Status("pxcharttop");
_pxBot   = Status("pxchartbottom");
_pxLeft  = Status("pxchartleft");
_pxRight = Status("pxchartright");
_axOk    = (_axMax > _axMin);

if (ShowEntryLine AND _curEntry > 0 AND _axOk)
{
    _entryY = _pxBot - (_curEntry - _axMin) / (_axMax - _axMin) * (_pxBot - _pxTop);

    GfxSetOverlayMode(1);
    // Pen style 2 = dashed (same as stop / target / price lines).
    GfxSelectPen(EntryLineColor, EntryLineWidth, 2);
    GfxMoveTo(_pxLeft, _entryY);
    GfxLineTo(_pxRight, _entryY);

    GfxSelectFont("Tahoma", 8, 700);
    GfxSetBkMode(1);
    GfxSetTextColor(EntryLineColor);
    GfxTextOut(NumToStr(_curEntry, 1.2), _pxRight + 4, _entryY - 8);
}

if (ShowStopLine AND _curStop > 0 AND _axOk)
{
    _stopY = _pxBot - (_curStop - _axMin) / (_axMax - _axMin) * (_pxBot - _pxTop);

    GfxSetOverlayMode(1);
    GfxSelectPen(StopLineColor, StopLineWidth, 2);
    GfxMoveTo(_pxLeft, _stopY);
    GfxLineTo(_pxRight, _stopY);

    GfxSelectFont("Tahoma", 8, 700);
    GfxSetBkMode(1);
    GfxSetTextColor(StopLineColor);
    GfxTextOut(NumToStr(_curStop, 1.2), _pxRight + 4, _stopY - 8);
}

if (ShowTargetLine AND _curTarget > 0 AND _axOk)
{
    _tgtY = _pxBot - (_curTarget - _axMin) / (_axMax - _axMin) * (_pxBot - _pxTop);

    GfxSetOverlayMode(1);
    GfxSelectPen(TargetLineColor, TargetLineWidth, 2);
    GfxMoveTo(_pxLeft, _tgtY);
    GfxLineTo(_pxRight, _tgtY);

    GfxSelectFont("Tahoma", 8, 700);
    GfxSetBkMode(1);
    GfxSetTextColor(TargetLineColor);
    GfxTextOut(NumToStr(_curTarget, 1.2), _pxRight + 4, _tgtY - 8);
}

if (ShowCurrentPriceLine AND _axOk)
{
    _curPx = C[BarCount - 1];
    if (_curPx > 0)
    {
        _priceY = _pxBot - (_curPx - _axMin) / (_axMax - _axMin) * (_pxBot - _pxTop);

        GfxSetOverlayMode(1);
        GfxSelectPen(CurrentPriceLineColor, CurrentPriceLineWidth, 2);
        GfxMoveTo(_pxLeft, _priceY);
        GfxLineTo(_pxRight, _priceY);

        GfxSelectFont("Tahoma", 8, 700);
        GfxSetBkMode(1);
        GfxSetTextColor(CurrentPriceLineColor);
        GfxTextOut(NumToStr(_curPx, 1.2), _pxRight + 4, _priceY - 8);
    }
}

// ============================================================================
// DISPLAY — Position Info Overlay (GFX)
// ----------------------------------------------------------------------------
// When EnableAutoTrade is on we MUST reflect the live IB account state, not
// the backtest's Pos* arrays.  Those arrays describe a simulated run; in
// auto-trading they routinely diverge from reality (stale in_trade flags
// from prior history, exits via VWAP rules while IB still holds, scale-ins,
// manual adjustments, etc.).  Reading IB StaticVars guarantees the overlay
// shows what the trader actually has at the broker.  When auto-trade is
// off, fall back to the backtest Pos* arrays so historical chart inspection
// still works.
// ============================================================================
lb = BarCount - 1;

_useIB = False;
if (EnableAutoTrade)
{
    _ibSvP = "IB_" + Name() + "_";
    _pDir  = Nz(StaticVarGet(_ibSvP + "Dir"));
    _useIB = True;
    if (_pDir != 0)
    {
        _pEntry = Nz(StaticVarGet(_ibSvP + "FillPx"));
        _pStop  = Nz(StaticVarGet(_ibSvP + "CurStop"));
        _pTgt   = Nz(StaticVarGet(_ibSvP + "TargetPx"));
        _pQty   = Nz(StaticVarGet(_ibSvP + "Qty"));
    }
    else
    {
        _pEntry = 0; _pStop = 0; _pTgt = 0; _pQty = 0;
    }
}
if (NOT _useIB)
{
    _pDir   = PosDir[lb];
    _pEntry = PosEntry[lb];
    _pStop  = PosStop[lb];
    _pTgt   = PosTarget[lb];
    _pQty   = PosQty[lb];
}
_pClose = C[lb];
_pReal  = Nz(StaticVarGet(_svPfx + "DayPL_" + NumToStr(dn[lb], 1.0)));
_pUnreal = 0;

GfxSetOverlayMode(1);
GfxSetBkMode(1);

_boxX  = 10;
_boxY  = 145;
_lineH = 18;
_row   = 0;

if (_pDir != 0)
{
    if (_pDir == 1)
    {
        _pUnreal = (_pClose - _pEntry) * _pQty;
        _pSide   = "LONG";
        _sideClr = colorGreen;
    }
    else
    {
        _pUnreal = (_pEntry - _pClose) * _pQty;
        _pSide   = "SHORT";
        _sideClr = colorRed;
    }

    GfxSelectFont("Tahoma", 9, 700);
    GfxSetTextColor(_sideClr);
    GfxTextOut(_pSide + "  " + NumToStr(_pQty, 1.0) + " shares", _boxX, _boxY + _lineH * _row);
    _row++;

    GfxSelectFont("Tahoma", 9, 400);
    GfxSetTextColor(colorWhite);
    if (_pEntry > 0) _entryStr = NumToStr(_pEntry, 1.2); else _entryStr = "--";
    if (_pStop  > 0) _stopStr  = NumToStr(_pStop,  1.2); else _stopStr  = "--";
    if (_pTgt   > 0) _tgtStr   = NumToStr(_pTgt,   1.2); else _tgtStr   = "--";
    GfxTextOut("Entry:        " + _entryStr, _boxX, _boxY + _lineH * _row); _row++;
    GfxTextOut("Stop:         " + _stopStr,  _boxX, _boxY + _lineH * _row); _row++;
    GfxTextOut("Target:       " + _tgtStr,   _boxX, _boxY + _lineH * _row); _row++;

    GfxSetTextColor(IIf(_pUnreal >= 0, colorGreen, colorRed));
    GfxTextOut("Unrealized:   " + NumToStr(_pUnreal, 1.2), _boxX, _boxY + _lineH * _row); _row++;
}
else
{
    GfxSelectFont("Tahoma", 9, 700);
    GfxSetTextColor(colorGrey40);
    GfxTextOut("FLAT", _boxX, _boxY + _lineH * _row);
    _row++;
}

_row++;
_pTotal = _pReal + _pUnreal;

GfxSelectFont("Tahoma", 9, 400);
GfxSetTextColor(IIf(_pReal >= 0, colorGreen, colorRed));
GfxTextOut("Realized:     " + NumToStr(_pReal, 1.2), _boxX, _boxY + _lineH * _row); _row++;

GfxSelectFont("Tahoma", 9, 700);
GfxSetTextColor(IIf(_pTotal >= 0, colorGreen, colorRed));
GfxTextOut("Total P/L:    " + NumToStr(_pTotal, 1.2), _boxX, _boxY + _lineH * _row);

// ============================================================================
// ALERTS — Trade Entry Only
// ============================================================================
AlertIf(Buy, "SOUND C:\\Windows\\Media\\notify.wav", StrategyCode + " LONG Entry: " + Name(), 1);
AlertIf(Short, "SOUND C:\\Windows\\Media\\notify.wav", StrategyCode + " SHORT Entry: " + Name(), 2);
