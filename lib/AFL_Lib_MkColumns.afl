    + ",MK_VWAP1,MK_VWAP2,MK_VWAP3,MK_VWAP4,MK_VWAP5,MK_VWAP,MK_DVWAP2,MK_DVWAP3"
    + ",MK_DVWAP4,MK_DVWAP5,MK_FCD,MK_FCP,MK_FCR,MK_FOD,MK_FOP,MK_FOR"
    + ",MK_FOW,MK_FCDP,MK_FCPP,MK_U5DD,MK_U5DP,MK_U10DD,MK_U10DP,MK_U20DD"
    + ",MK_U20DP,MK_UYD,MK_UYP,MK_R5M,MK_R15M,MK_R30M,MK_R60M,MK_BelowHigh"
    + ",MK_AboveLow,MK_BelowHighPre,MK_AboveLowPre,MK_RD,MK_RPD,MK_RPM,MK_R5D,MK_R10D"
