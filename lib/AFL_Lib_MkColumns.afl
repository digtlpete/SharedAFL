// ============================================================================
// LIB: MK BACKTEST COLUMNS — Trade-Ideas column library on the trade list
// ----------------------------------------------------------------------------
// One copy of the MK_ column list for every strategy that uses the pipe
// custom-backtest library (AFL_Lib_CustomBacktest.afl).
//
// REQUIRES, before this include:
//   shared_variables.afl (or mabekit.afl) so the MK_ arrays exist
//   UseMkColumns = 1;   // set 0 to omit these columns from this strategy
//
// Each strategy still does three things:
//   1. Include this file.
//   2. On entry:  cbt_mk = MkColumnPayload(bar);
//   3. On exit:   append "|" + cbt_mk to the pipe payload, and append
//                 MkColumnNames() to CbtFieldNames.
//
// MkColumnPayload and CbtMkFieldNames are the same order. Strategy-specific
// fields stay in front of this list. Do not insert MK_ columns between them.
// BP_ columns from BP_Columns.afl are appended after the last MK_ field.
// Portfolio backtest only. The custom-backtest loop stops at 512 fields.
// ============================================================================

if (IsEmpty(VarGet("UseMkColumns")))
    UseMkColumns = 1;
_MkColumnsOn = UseMkColumns;
CbtMkFieldNames = "";

function MkColumnNum(v, fmt)
{
    return StrReplace(NumToStr(v, fmt, False), ",", ".");
}

function MkColumnPayload(bar)
{
    local s;
    s = "";
    if (_MkColumnsOn)
    {
    s = MkColumnNum(MK_Price[bar], 1.2);
    s = s + "|" + MkColumnNum(MK_GUD[bar], 1.2);
